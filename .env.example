# --- Backtest Orchestrator Configuration ---
# Date boundaries for the backtest window (YYYY-MM-DD format).
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-03-31

# Trailing window for covariance and caps calculation (in trading days).
BACKTEST_WINDOW_DAYS=252

# Transaction cost basis points applied to turnover.
BACKTEST_TCOST_BPS=10.0

# Penalty/risk aversion factor applied to portfolio variance.
BACKTEST_RISK_AVERSION=1.0

# The URLs of the solver engines (already mapped internally in Docker network).
BACKTEST_MARKOWITZ_URL=http://markowitz-service:8000/optimize
BACKTEST_QAOA_URL=http://qaoa-service:8001/optimize

# --- Results API Configuration ---
# In docker-compose, this is mapped internally to /app/results_store_data/results.db
DB_PATH=./results.db
